      <div class="admin-modal-header">
        <h3 class="admin-modal-title">Change Product Artwork</h3>
        <button type="button" class="admin-modal-close" onclick="closeImageModal()">&times;</button>
      </div>
      <form id="imageForm" onsubmit="handleImageFormSubmit(event)">
        <input type="hidden" id="quickImgProdId">
        <div class="admin-modal-body">
          <div style="text-align: center; margin-bottom: 16px;">
            <div class="prod-id-pill" id="quickImgProdIdPill">RJ-ER-01</div>
            <h4 id="quickImgProdTitle" style="color: #ffffff; font-size: 16px; margin-top: 6px;">Product Title</h4>
          </div>

          <div class="img-preview-box" style="width: 140px; height: 140px;">
            <img id="quickImgPreview" src="" alt="Artwork Preview">
          </div>

          <div class="img-upload-dropzone" onclick="document.getElementById('quickImgFileInput').click()">
            <input type="file" id="quickImgFileInput" accept="image/*" style="display: none;" onchange="handleModalFilePreview(event, 'quickImgPreview', 'quickImgPath')">
            <div style="font-size: 13.5px; color: var(--gold-light); font-weight: 600; margin-bottom: 4px;">Upload New Image File</div>
            <div style="font-size: 11px; color: var(--text-muted);">Replaces artwork instantly across showroom</div>
          </div>

          <div style="margin-top: 14px;">
            <label for="quickImgPath" style="font-size: 11px; text-transform: uppercase; color: var(--gold-light); display: block; margin-bottom: 4px;">Or Direct Image URL / Path</label>
            <input type="text" class="form-control" id="quickImgPath" placeholder="/assets/Earrings/product(1).png" oninput="document.getElementById('quickImgPreview').src = this.value">
          </div>
        </div>

        <div class="admin-modal-footer">
          <button type="button" class="btn-refresh-feed" onclick="closeImageModal()">Cancel</button>
          <button type="submit" class="btn-save-rates">Update Artwork</button>
        </div>
