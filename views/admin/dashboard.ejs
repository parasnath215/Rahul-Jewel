    </div>
  </div>

  <!-- Toast Notification element -->
  <div id="toast" class="toast-notify">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#b78a3d" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
    <span id="toastMsg">Action completed successfully</span>
  </div>

  <script>
    let currentMode = '<%= ratesConfig.mode %>';

    // Tab Switching
    function switchTab(tabId) {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));

      if (tabId === 'inquiries') {
        const btn = document.getElementById('tab-btn-inquiries') || document.querySelector('.tab-btn:nth-child(1)');
        if (btn) btn.classList.add('active');
        document.getElementById('tab-inquiries').classList.add('active');
      } else if (tabId === 'rates') {
        const btn = document.getElementById('tab-btn-rates') || document.querySelector('.tab-btn:nth-child(2)');
        if (btn) btn.classList.add('active');
        document.getElementById('tab-rates').classList.add('active');
        recalcMatrix();
      } else if (tabId === 'products') {
        const btn = document.getElementById('tab-btn-products') || document.querySelector('.tab-btn:nth-child(3)');
        if (btn) btn.classList.add('active');
        document.getElementById('tab-products').classList.add('active');
      }
    }

    // Toast Notification
    function showToast(message) {
      const toast = document.getElementById('toast');
      document.getElementById('toastMsg').innerText = message;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 3500);
    }

    // ----------------------------------------------------
    // INQUIRIES MANAGEMENT
    // ----------------------------------------------------
    let activeStatusFilter = 'all';

    function setStatusFilter(status) {
      activeStatusFilter = status;
      document.querySelectorAll('.pill-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.status === status);
      });
      filterInquiries();
    }

    function filterInquiries() {
      const query = (document.getElementById('searchInquiries').value || '').toLowerCase().trim();
      const rows = document.querySelectorAll('#inquiriesTableBody tr');

      rows.forEach(row => {
        if (!row.dataset.status) return; // skip empty state row
        const rowStatus = row.dataset.status;
        const rowSearch = row.dataset.search || '';

        const statusMatch = activeStatusFilter === 'all' || rowStatus === activeStatusFilter;
        const queryMatch = !query || rowSearch.includes(query);

        row.style.display = (statusMatch && queryMatch) ? '' : 'none';
      });
    }

    // Update Status via AJAX
    async function updateInquiryStatus(id, newStatus, selectElem) {
      try {
        const res = await fetch(`/admin/api/inquiries/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: newStatus })
        });
        const data = await res.json();
        if (data.success) {
          selectElem.className = `status-select ${newStatus}`;
          const row = document.getElementById(`row-${id}`);
          if (row) row.dataset.status = newStatus;
          showToast(`Inquiry ${id} status updated to ${newStatus.toUpperCase()}`);
          filterInquiries();
        } else {
          alert('Error updating status: ' + data.error);
        }
      } catch (e) {
        alert('Failed to connect to server');
      }
    }

    // Save Internal Notes
    async function saveInquiryNotes(id) {
      const notesVal = document.getElementById(`notes-${id}`).value;
      try {
        const res = await fetch(`/admin/api/inquiries/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ notes: notesVal })
        });
        const data = await res.json();
        if (data.success) {
          showToast(`Notes saved for inquiry ${id}`);
        } else {
          alert('Error saving notes');
        }
      } catch (e) {
        alert('Failed to save notes');
      }
    }

    // Delete Inquiry
    async function deleteInquiry(id) {
      if (!confirm(`Are you sure you want to delete inquiry ${id}? This action cannot be undone.`)) {
        return;
      }
      try {
        const res = await fetch(`/admin/api/inquiries/${id}`, {
          method: 'DELETE'
        });
        const data = await res.json();
        if (data.success) {
          const row = document.getElementById(`row-${id}`);
          if (row) row.remove();
          showToast(`Inquiry ${id} deleted`);
          // Update badge
          const count = document.querySelectorAll('#inquiriesTableBody tr[data-status]').length;
          document.getElementById('tabInquiryBadge').innerText = count;
          document.getElementById('kpiTotalInquiries').innerText = count;
        } else {
          alert('Error deleting inquiry');
        }
      } catch (e) {
        alert('Failed to connect to server');
      }
    }

    // ----------------------------------------------------
    // RATES MANAGEMENT
    // ----------------------------------------------------
    function recalcMatrix() {
      const g24 = parseFloat(document.getElementById('gold24k_1g').value) || 0;
      const sil = parseFloat(document.getElementById('silver_1g').value) || 0;
      const plat = parseFloat(document.getElementById('platinum_1g').value) || 0;

      const g24_10 = Math.round(g24 * 10);
      const g22_10 = Math.round(g24 * 10 * (22 / 24));
      const g18_10 = Math.round(g24 * 10 * (18 / 24));
      const g14_10 = Math.round(g24 * 10 * (14 / 24));
      const sil_1k = Math.round(sil * 1000);
      const plat_10 = Math.round(plat * 10);

      document.getElementById('hint24k10g').innerText = g24_10.toLocaleString('en-IN');
      document.getElementById('hintSil1kg').innerText = sil_1k.toLocaleString('en-IN');

      document.getElementById('calc24k10g').innerText = '₹' + g24_10.toLocaleString('en-IN');
      document.getElementById('calc22k10g').innerText = '₹' + g22_10.toLocaleString('en-IN');
      document.getElementById('calc18k10g').innerText = '₹' + g18_10.toLocaleString('en-IN');
      document.getElementById('calc14k10g').innerText = '₹' + g14_10.toLocaleString('en-IN');
      document.getElementById('calcSil1kg').innerText = '₹' + sil_1k.toLocaleString('en-IN');
      document.getElementById('calcPlat10g').innerText = '₹' + plat_10.toLocaleString('en-IN');
    }

    function setMode(mode) {
      currentMode = mode;
      document.getElementById('btnModeAuto').classList.toggle('active', mode === 'auto');
      document.getElementById('btnModeManual').classList.toggle('active', mode === 'manual');

      const banner = document.getElementById('modeBanner');
      banner.className = `mode-indicator-banner ${mode}`;
      if (mode === 'manual') {
        document.getElementById('modeTitle').innerText = 'Showroom Manual Override Active';
        document.getElementById('modeDesc').innerText = 'Board rates are locked to your showroom custom values and published immediately across all pages.';
      } else {
        document.getElementById('modeTitle').innerText = 'Automatic Live Market Feed Active';
        document.getElementById('modeDesc').innerText = 'Rates are dynamically fetched from bullion feeds and cached for 10 minutes.';
      }
    }

    // Save Rates
    async function saveRates(e) {
      e.preventDefault();
      const gold24k_1g = document.getElementById('gold24k_1g').value;
      const silver_1g = document.getElementById('silver_1g').value;
      const platinum_1g = document.getElementById('platinum_1g').value;
      const customDateDisplay = document.getElementById('customDateDisplay').value;

      try {
        const res = await fetch('/admin/api/rates', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            mode: currentMode,
            gold24k_1g,
            silver_1g,
            platinum_1g,
            customDateDisplay
          })
        });
        const data = await res.json();
        if (data.success) {
          showToast('Board rates saved and published to live website!');
          updateLivePreview(data.rates);
        } else {
          alert('Error saving rates: ' + data.error);
        }
      } catch (err) {
        alert('Failed to connect to server');
      }
    }

    // Trigger Market Spot Refresh
    async function triggerMarketSpotRefresh() {
      try {
        const res = await fetch('/admin/api/rates/refresh', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          showToast('Fresh market spot rates fetched successfully!');
          if (data.data) {
            updateLivePreview(data.data);
            if (data.data.gold24k) {
              document.getElementById('gold24k_1g').value = data.data.gold24k.rate1g;
              document.getElementById('silver_1g').value = Math.round(data.data.silver.rate1kg / 1000);
              document.getElementById('platinum_1g').value = data.data.platinum.rate1g;
              recalcMatrix();
            }
          }
        }
      } catch (err) {
        alert('Failed to fetch live market spot');
      }
    }

    function updateLivePreview(rates) {
      if (!rates || !rates.featured) return;
      document.getElementById('prevGoldVal').innerText = '₹' + rates.featured.gold24k_10g.value;
      document.getElementById('prevSilVal').innerText = '₹' + rates.featured.silver_1kg.value;
      document.getElementById('bannerLastUpdated').innerText = rates.lastUpdatedIST;

      if (rates.gold24k) {
        document.getElementById('prevRow24k1g').innerText = '₹' + rates.gold24k.rate1g.toLocaleString('en-IN');
        document.getElementById('prevRow24k10g').innerText = '₹' + rates.gold24k.rate10g.toLocaleString('en-IN');
      }
      if (rates.gold22k) {
        document.getElementById('prevRow22k1g').innerText = '₹' + rates.gold22k.rate1g.toLocaleString('en-IN');
        document.getElementById('prevRow22k10g').innerText = '₹' + rates.gold22k.rate10g.toLocaleString('en-IN');
      }
      if (rates.gold18k) {
        document.getElementById('prevRow18k1g').innerText = '₹' + rates.gold18k.rate1g.toLocaleString('en-IN');
        document.getElementById('prevRow18k10g').innerText = '₹' + rates.gold18k.rate10g.toLocaleString('en-IN');
      }
      if (rates.silver) {
        document.getElementById('prevRowSil1kg').innerText = '₹' + rates.silver.rate1kg.toLocaleString('en-IN');
      }

      const badge = document.getElementById('previewModeBadge');
      if (rates.mode === 'manual') {
        badge.className = 'badge-status badge-manual';
        badge.innerText = 'Manual Override';
      } else {
        badge.className = 'badge-status badge-auto';
        badge.innerText = 'Auto Live';
      }
    }

    // Run initial calc
    recalcMatrix();

    // ----------------------------------------------------
    // PRODUCT CATALOG MANAGEMENT
    // ----------------------------------------------------
    const productsData = <%- JSON.stringify(products).replace(/</g, '\\u003c') %>;
    let activeProductCatFilter = 'all';

    function setProductCategoryFilter(catKey) {
      activeProductCatFilter = catKey;
      document.querySelectorAll('#productCatPills .pill-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.cat === catKey);
      });
      filterProducts();
    }

    function filterProducts() {
      const query = (document.getElementById('searchProducts').value || '').toLowerCase().trim();
      const rows = document.querySelectorAll('#productsTableBody tr');

      let visibleCount = 0;
      rows.forEach(row => {
        if (!row.dataset.cat) return;
        const rowCat = row.dataset.cat;
        const rowSearch = row.dataset.search || '';

        const catMatch = activeProductCatFilter === 'all' || rowCat === activeProductCatFilter;
        const queryMatch = !query || rowSearch.includes(query);

        if (catMatch && queryMatch) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });
    }

    // Auto-generate ID on category selection
    function handleCategoryChange() {
      const cat = document.getElementById('prodCategory').value;
      const mode = document.getElementById('prodEditMode').value;
      if (mode === 'create') {
        const prefixMap = {
          earrings: 'RJ-ER',
          bracelets: 'RJ-BR',
          chains: 'RJ-CH',
          bangles: 'RJ-BG',
          necklaces: 'RJ-NC',
          rings: 'RJ-RG',
          studs: 'RJ-ST',
          'fancy-chains': 'RJ-FC'
        };
        const prefix = prefixMap[cat] || 'RJ-PR';
        const rows = document.querySelectorAll(`#productsTableBody tr[data-cat="${cat}"]`);
        const nextNum = String(rows.length + 1).padStart(2, '0');
        document.getElementById('prodId').value = `${prefix}-${nextNum}`;
      }
    }

    // Modal File Preview handler (reads base64 for instant preview)
    let pendingFileBase64 = null;
    let pendingQuickFileBase64 = null;

    function handleModalFilePreview(event, previewImgId, pathInputId) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById(previewImgId).src = e.target.result;
        if (previewImgId === 'prodModalImgPreview') {
          pendingFileBase64 = e.target.result;
        } else {
          pendingQuickFileBase64 = e.target.result;
        }
        if (pathInputId) {
          document.getElementById(pathInputId).value = `[Uploaded File: ${file.name}]`;
        }
      };
      reader.readAsDataURL(file);
    }

    // Open Add Product Modal
    function openAddProductModal() {
      document.getElementById('prodEditMode').value = 'create';
      document.getElementById('productModalHeading').innerText = 'Add Showroom Product';
      document.getElementById('btnSaveProduct').innerText = 'Add to Catalog';
      document.getElementById('prodId').readOnly = false;
      document.getElementById('prodId').style.opacity = '1';
      document.getElementById('productForm').reset();
      pendingFileBase64 = null;
      document.getElementById('prodCategory').value = 'earrings';
      document.getElementById('prodCert').value = 'BIS 100% Certified & SGL Verified';
      document.getElementById('prodTags').value = 'diamond, gold';
      document.getElementById('prodModalImgPreview').src = '/assets/Earrings/product(1).png';
      document.getElementById('prodModalImgPath').value = '/assets/Earrings/product(1).png';
      handleCategoryChange();
      document.getElementById('productModal').classList.add('active');
    }

    // Open Edit Product Modal
    function openEditProductModal(productId) {
      const prod = productsData.find(p => p.id === productId);
      if (!prod) {
        showToast('Product not found: ' + productId);
        return;
      }

      document.getElementById('prodEditMode').value = 'edit';
      document.getElementById('productModalHeading').innerText = 'Edit Product Details (' + prod.id + ')';
      document.getElementById('btnSaveProduct').innerText = 'Save Changes';
      document.getElementById('prodId').value = prod.id;
      document.getElementById('prodId').readOnly = true;
      document.getElementById('prodId').style.opacity = '0.7';

      document.getElementById('prodCategory').value = prod.categoryKey;
      document.getElementById('prodTitle').value = prod.title;
      document.getElementById('prodPurity').value = prod.purity;
      document.getElementById('prodWeight').value = prod.weight;
      document.getElementById('prodDiamonds').value = prod.diamonds;
      document.getElementById('prodCert').value = prod.cert || 'BIS 100% Certified & SGL Verified';
      document.getElementById('prodTags').value = Array.isArray(prod.tags) ? prod.tags.join(', ') : prod.tags;

      document.getElementById('prodModalImgPreview').src = prod.image;
      document.getElementById('prodModalImgPath').value = prod.image;
      pendingFileBase64 = null;

      document.getElementById('productModal').classList.add('active');
    }

    function closeProductModal() {
      document.getElementById('productModal').classList.remove('active');
    }

    // Open Quick Change Image Modal
    function openChangeImageModal(productId) {
      const prod = productsData.find(p => p.id === productId);
      if (!prod) return;

      document.getElementById('quickImgProdId').value = prod.id;
      document.getElementById('quickImgProdIdPill').innerText = prod.id;
      document.getElementById('quickImgProdTitle').innerText = prod.title;
      document.getElementById('quickImgPreview').src = prod.image;
      document.getElementById('quickImgPath').value = prod.image;
      pendingQuickFileBase64 = null;
      document.getElementById('quickImgFileInput').value = '';

      document.getElementById('imageModal').classList.add('active');
    }

    function closeImageModal() {
      document.getElementById('imageModal').classList.remove('active');
    }

    // Submit Add/Edit Product
    async function handleProductFormSubmit(e) {
      e.preventDefault();
      const mode = document.getElementById('prodEditMode').value;
      const id = document.getElementById('prodId').value.trim();
      const categoryKey = document.getElementById('prodCategory').value;
      const title = document.getElementById('prodTitle').value.trim();
      const purity = document.getElementById('prodPurity').value.trim();
      const weight = document.getElementById('prodWeight').value.trim();
      const diamonds = document.getElementById('prodDiamonds').value.trim();
      const cert = document.getElementById('prodCert').value.trim();
      const tags = document.getElementById('prodTags').value.trim();
      const imagePath = document.getElementById('prodModalImgPath').value.trim();

      const payload = {
        id,
        categoryKey,
        title,
        purity,
        weight,
        diamonds,
        cert,
        tags,
        image: imagePath.startsWith('[Uploaded') ? '' : imagePath,
        imageBase64: pendingFileBase64
      };

      const saveBtn = document.getElementById('btnSaveProduct');
      saveBtn.disabled = true;
      saveBtn.innerText = 'Saving...';

      try {
        const url = mode === 'create' ? '/admin/api/products' : `/admin/api/products/${encodeURIComponent(id)}`;
        const method = mode === 'create' ? 'POST' : 'PUT';

        const res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();

        if (data.success) {
          showToast(mode === 'create' ? `Product ${id} added successfully!` : `Product ${id} updated!`);
          closeProductModal();
          setTimeout(() => window.location.reload(), 1000);
        } else {
          alert('Error: ' + (data.error || 'Failed to save product.'));
        }
      } catch (err) {
        console.error(err);
        alert('Network error while saving product.');
      } finally {
        saveBtn.disabled = false;
        saveBtn.innerText = 'Save Product';
      }
    }

    // Submit Quick Image Change
    async function handleImageFormSubmit(e) {
      e.preventDefault();
      const id = document.getElementById('quickImgProdId').value;
      const directPath = document.getElementById('quickImgPath').value.trim();

      const payload = {
        image: directPath.startsWith('[Uploaded') ? '' : directPath,
        imageBase64: pendingQuickFileBase64
      };

      try {
        const res = await fetch(`/admin/api/products/${encodeURIComponent(id)}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();

        if (data.success) {
          showToast(`Artwork for ${id} updated successfully!`);
          closeImageModal();
          // Update live thumbnail on page
          const thumb = document.getElementById(`thumb-${id}`);
          if (thumb && data.product && data.product.image) {
            thumb.src = data.product.image;
          }
          // Update cached data
          const p = productsData.find(x => x.id === id);
          if (p && data.product) p.image = data.product.image;
        } else {
          alert('Error: ' + (data.error || 'Failed to update image.'));
        }
      } catch (err) {
        console.error(err);
        alert('Network error while updating image.');
      }
    }

    // Delete Product
    async function deleteProductConfirm(id, title) {
      if (!confirm(`Are you sure you want to permanently delete "${title}" (${id}) from the catalog?`)) {
        return;
      }

      try {
        const res = await fetch(`/admin/api/products/${encodeURIComponent(id)}`, {
          method: 'DELETE'
        });
        const data = await res.json();

        if (data.success) {
          showToast(`Product ${id} removed from catalog.`);
          const row = document.getElementById(`prod-row-${id}`);
          if (row) row.remove();
          // Decrement badges
          const totalBadge = document.getElementById('tabProductBadge');
          if (totalBadge) totalBadge.innerText = parseInt(totalBadge.innerText, 10) - 1;
          const kpi = document.getElementById('kpiTotalProducts');
          if (kpi) kpi.innerText = parseInt(kpi.innerText, 10) - 1;
        } else {
          alert('Error: ' + (data.error || 'Failed to delete product.'));
        }
      } catch (err) {
        console.error(err);
        alert('Network error while deleting product.');
      }
    }

    // Trigger Sync Static HTML Files
    async function triggerSyncStaticHtml() {
      try {
        showToast('Synchronizing static HTML category pages...');
        const res = await fetch('/admin/api/products/sync-static', {
          method: 'POST'
        });
        const data = await res.json();
        if (data.success) {
          showToast('All static HTML category files synchronized successfully!');
        } else {
          alert('Error: ' + (data.error || 'Failed to sync.'));
        }
      } catch (err) {
        alert('Network error while syncing files.');
      }
    }
  </script>
</body>
</html>

