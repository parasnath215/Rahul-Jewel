<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Royal Noor Polki &amp; Zambian Emerald Choker | Rahul Jewellers</title>
  <meta name="description" content="Sculpted by master jewel-smiths of Lucknow. The Royal Noor Polki & Zambian Emerald Choker in 22KT gold, uncut Polki diamonds, and untreated emerald drops.">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/pages.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="icon" type="image/png" href="/assets/favicon.png">
  <link rel="shortcut icon" href="/assets/favicon.png">
</head>
<body>

  <!-- Top Announcement Bar -->
  <%- include('partials/top-bar') %>


  <!-- Main Navigation Header -->
  <%- include('partials/header', { activeCategory: 'bracelets', activePage: 'product' }) %>

  <!-- Breadcrumb -->
  <div class="breadcrumb-wrap">
    <div class="breadcrumb-container">
      <a href="/">Home</a>
      <span class="sep">&gt;</span>
      <a href="/collections/necklaces">Gold</a>
      <span class="sep">&gt;</span>
      <span class="current">Choker</span>
    </div>
  </div>

  <!-- Product Detail Section -->
  <main class="product-detail-container">
    <div class="product-layout">

      <!-- Left Column: Gallery -->
      <div class="product-gallery">
        <div class="main-image-wrap">
          <img id="mainProductImg" src="/assets/product/choker_main.jpg" alt="The Royal Noor Polki & Zambian Emerald Choker">
          <div class="hallmark-pill">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="#b78a3d" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Hallmarked 916
          </div>
        </div>

        <div class="thumbnail-row">
          <div class="thumb-item active" onclick="switchProductImage('/assets/product/choker_thumb_1.jpg', this)">
            <img src="/assets/product/choker_thumb_1.jpg" alt="Choker Full Collar View">
          </div>
          <div class="thumb-item" onclick="switchProductImage('/assets/product/choker_thumb_2.jpg', this)">
            <img src="/assets/product/choker_thumb_2.jpg" alt="Choker On Model View">
          </div>
          <div class="thumb-item" onclick="switchProductImage('/assets/product/choker_thumb_3.jpg', this)">
            <img src="/assets/product/choker_thumb_3.jpg" alt="Polki Diamond Foil Setting Macro">
          </div>
          <div class="thumb-item" onclick="switchProductImage('/assets/product/choker_thumb_4.jpg', this)">
            <img src="/assets/product/choker_thumb_4.jpg" alt="Reverse Meenakari Peacock Artwork">
          </div>
        </div>
      </div>

      <!-- Right Column: Details & Order -->
      <div class="product-details">
        <div class="product-eyebrow">HERITAGE BRIDAL ATELIER &bull; LIMITED EDITION</div>
        <h1 class="product-title">The Royal Noor Polki &amp; Zambian Emerald Choker</h1>

        <div class="product-sku-row">
          <span>SKU: <strong class="sku-code">RJL-BR-2026-088</strong></span>
          <span class="availability-badge">
            <span style="color: #22c55e; font-size: 14px;">&#9679;</span>
            Available For Bespoke Commission
          </span>
        </div>

        <p class="product-desc">
          Sculpted by master jewel-smiths of Lucknow, this heritage collar revives Mughal-era opulence. Hand-selected uncut Polki diamonds in traditional 24-karat gold foil settings are crowned by untreated, royal-green Zambian emerald drops, finished with hand-painted peacock meenakari on the reverse.
        </p>

        <!-- Metal Selection -->
        <div class="metal-selection-box">
          <div class="metal-header">
            <span>Primary Precious Metal</span>
            <span id="selectedMetalText" style="font-size: 11px; text-transform: none; color: #64748b; font-weight: 500;">22KT Yellow Gold (Standard 916)</span>
          </div>
          <div class="metal-options">
            <button type="button" class="metal-btn active" id="metalBtn22" onclick="selectMetal('22kt', '22KT Yellow Gold (Standard 916)', this)">
              <span class="dot-gold"></span>
              22KT Royal Gold
            </button>
            <button type="button" class="metal-btn" id="metalBtn18" onclick="selectMetal('18kt', '18KT Rose Gold (Hallmarked 750)', this)">
              <span class="dot-rose"></span>
              18KT Rose Gold
            </button>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="product-actions">
          <button type="button" class="btn-enquire" onclick="openEnquiryModal()">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3h12l4 6-10 12L2 9z"/></svg>
            ENQUIRE NOW &rarr;
          </button>
          <a class="btn-chat-whatsapp" href="https://wa.me/919559777770?text=Hello%20Rahul%20Jewellers,%20I%20am%20interested%20in%20The%20Royal%20Noor%20Polki%20%26%20Zambian%20Emerald%20Choker%20(SKU:%20RJL-BR-2026-088)" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            CHAT WITH US
          </a>
        </div>

        <!-- Trust Badges 2x2 Grid -->
        <div class="trust-badges-grid">
          <div class="trust-badge-card">
            <div class="tb-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#b78a3d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div class="tb-text">
              <h5>100% BIS Hallmarked</h5>
              <p>Government certified 916 gold purity guarantee.</p>
            </div>
          </div>

          <div class="trust-badge-card">
            <div class="tb-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#b78a3d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9z"/></svg>
            </div>
            <div class="tb-text">
              <h5>Certified Natural Polki</h5>
              <p>GIA / IGI grading laboratory dossiers included.</p>
            </div>
          </div>

          <div class="trust-badge-card">
            <div class="tb-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#b78a3d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
            </div>
            <div class="tb-text">
              <h5>Lifetime Exchange*</h5>
              <p>Transparent buyback &amp; restorative atelier care.</p>
            </div>
          </div>

          <div class="trust-badge-card">
            <div class="tb-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#b78a3d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <div class="tb-text">
              <h5>Insured White-Glove</h5>
              <p>Armoured secure transit across India &amp; overseas.</p>
            </div>
          </div>
        </div>

      </div>

    </div>
  </main>

  <!-- Quick Enquiry Modal -->
  <div id="enquiryModal" style="display:none; position:fixed; inset:0; width:100%; height:100%; background:rgba(10,42,35,0.7); backdrop-filter:blur(4px); -webkit-backdrop-filter:blur(4px); z-index:1000; align-items:center; justify-content:center; padding:16px; box-sizing:border-box;">
    <div style="background:#ffffff; border-radius:8px; max-width:480px; width:100%; padding:28px 24px; box-shadow:0 20px 60px rgba(0,0,0,0.3); position:relative; max-height:90vh; overflow-y:auto; box-sizing:border-box;">
      <button onclick="closeEnquiryModal()" style="position:absolute; top:14px; right:14px; width:36px; height:36px; border-radius:50%; background:#f1f5f9; border:none; font-size:22px; cursor:pointer; color:#64748b; display:flex; align-items:center; justify-content:center; line-height:1;" aria-label="Close modal">&times;</button>
      <h3 style="font-family:var(--font-serif); font-size:24px; color:#171a18; margin-bottom:6px; padding-right:32px;">Bespoke Commission Enquiry</h3>
      <p style="font-size:13px; color:#64748b; margin-bottom:18px;">The Royal Noor Polki &amp; Zambian Emerald Choker</p>

      <form onsubmit="handleProductEnquiry(event)">
        <input type="hidden" name="product" value="The Royal Noor Polki & Zambian Emerald Choker (SKU: RJL-BR-2026-088)">
        <div style="margin-bottom:12px;">
          <input type="text" name="name" placeholder="Your Full Name*" required style="width:100%; padding:12px 14px; border:1px solid #cbd5e1; border-radius:4px; font-size:14px; box-sizing:border-box;">
        </div>
        <div style="margin-bottom:12px;">
          <input type="tel" name="phone" placeholder="Phone / WhatsApp Number*" required style="width:100%; padding:12px 14px; border:1px solid #cbd5e1; border-radius:4px; font-size:14px; box-sizing:border-box;">
        </div>
        <div style="margin-bottom:16px;">
          <textarea name="notes" placeholder="Customization requirements (e.g. emerald sizing, matching earrings)..." rows="3" style="width:100%; padding:12px 14px; border:1px solid #cbd5e1; border-radius:4px; font-size:14px; box-sizing:border-box;"></textarea>
        </div>
        <button type="submit" class="btn-enquire" style="width:100%; justify-content:center; min-height:48px;">SUBMIT INQUIRY</button>
        <div id="modalFeedback" style="display:none; margin-top:12px; font-size:13px; padding:10px; border-radius:4px;"></div>
      </form>
    </div>
  </div>

  <!-- Line-Art Palace Footer -->
  <%- include('partials/footer') %>

  <script>
    // Image Switcher
    function switchProductImage(src, element) {
      document.getElementById('mainProductImg').src = src;
      document.querySelectorAll('.thumb-item').forEach(el => el.classList.remove('active'));
      if (element) element.classList.add('active');
    }

    // Metal Selector
    function selectMetal(metalType, label, btn) {
      document.querySelectorAll('.metal-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('selectedMetalText').innerText = label;
    }

    // Enquiry Modal
    function openEnquiryModal() {
      const modal = document.getElementById('enquiryModal');
      modal.style.display = 'flex';
    }

    function closeEnquiryModal() {
      document.getElementById('enquiryModal').style.display = 'none';
    }
  </script>

  <script src="/js/header.js"></script>

  <script>
    async function handleProductEnquiry(e) {
      e.preventDefault();
      const form = e.target;
      const feedback = document.getElementById('modalFeedback');
      feedback.style.display = 'block';
      feedback.style.background = '#dcfce7';
      feedback.style.color = '#166534';
      feedback.innerHTML = '&#10004; Inquiry sent! Our concierge will WhatsApp or call you shortly.';

      try {
        await fetch('/api/inquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: form.name.value,
            phone: form.phone.value,
            message: form.product.value + ' | ' + (form.notes.value || 'No extra notes'),
            source: 'Product Detail Enquiry'
          })
        });
      } catch (err) {}

      setTimeout(() => {
        closeEnquiryModal();
        feedback.style.display = 'none';
        form.reset();
      }, 2500);
    }
  </script>
</body>
</html>
