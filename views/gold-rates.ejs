<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Live Gold &amp; Silver Metal Rates | Rahul Jewellers Legacy - Lucknow</title>
  <meta name="description" content="Check official live Indian market rates for 24K, 22K, 18K, 14K Gold per 10g, Silver per 1kg, and Platinum in INR. Updated every 10 minutes from IBJA &amp; bullion markets.">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/pages.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="icon" type="image/png" href="/assets/favicon.png">
  <link rel="shortcut icon" href="/assets/favicon.png">
</head>
<body>

  <!-- Top Announcement Bar -->
  <%- include('partials/top-bar') %>

  <!-- Main Navigation Header -->
  <%- include('partials/header', { activePage: 'gold-rates' }) %>

  <!-- Breadcrumb -->
  <div class="breadcrumb-wrap">
    <div class="breadcrumb-container">
      <a href="/">Home</a>
      <span class="sep">&gt;</span>
      <span class="current">Gold Rates</span>
    </div>
  </div>

  <!-- Gold Rates Main Section -->
  <main class="rates-page-container">
    <h1 class="rates-page-title" id="ratesTitle">Metal Rates (<%= rates.pageTitleDate || rates.currentDateDisplay %>)</h1>

    <!-- 2 Highlight Tiles (Matching reference design) -->
    <div class="rates-hero-grid">
      <!-- Gold 24 Carat (10G) -->
      <div class="rates-feature-tile">
        <img class="abs-fill" src="/assets/rate-gold.png" alt="Gold 24 Carat (10G)">
        <div class="tile-gradient-overlay"></div>
        <div class="tile-content">
          <div>
            <div class="tile-label">GOLD 24 CARAT (10G)</div>
            <div class="tile-value-wrap">
              <span class="tile-value" id="featuredGoldVal"><%= rates.featured.gold24k_10g.value %></span>
              <span class="trend-icon-up" aria-label="Rate up">&#9650;</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Silver (1 KG) -->
      <div class="rates-feature-tile">
        <img class="abs-fill" src="/assets/rate-silver.png" alt="Silver (1 KG)">
        <div class="tile-gradient-overlay"></div>
        <div class="tile-content">
          <div>
            <div class="tile-label">SILVER (1 KG)</div>
            <div class="tile-value-wrap">
              <span class="tile-value" id="featuredSilverVal"><%= rates.featured.silver_1kg.value %></span>
              <span class="trend-icon-down" aria-label="Rate down">&#9660;</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Table Card 1: ALL METAL RATES -->
    <div class="rates-card">
      <div class="rates-card-header">
        <div class="rates-card-title-row">
          <h2>ALL METAL RATES</h2>
          <span class="gold-decor-line" aria-hidden="true"></span>
        </div>
        <p class="rates-disclaimer">* GST, Hallmarking &amp; Making Charges are Extra</p>
      </div>

      <div class="table-responsive">
        <table class="rates-table" id="allMetalTable">
          <thead>
            <tr>
              <th style="text-align: left;">METAL</th>
              <th>1G</th>
              <th>5G</th>
              <th>8G</th>
              <th>10G</th>
              <th>50G</th>
              <th>100G</th>
            </tr>
          </thead>
          <tbody>
<% rates.allMetalRates.forEach(function(row) { %>
            <tr>
              <td><%= row.metal %></td>
              <td><%= row.w1_formatted %></td>
              <td><%= row.w5_formatted %></td>
              <td><%= row.w8_formatted %></td>
              <td><%= row.w10_formatted %></td>
              <td><%= row.w50_formatted %></td>
              <td><%= row.w100_formatted %></td>
            </tr>
<% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Table Card 2: PRICE HISTORY (1g rate, 12:00 fetch) -->
    <div class="rates-card">
      <div class="rates-card-header">
        <div class="rates-card-title-row">
          <h2>PRICE HISTORY <span class="sub-note">(1g rate, 12:00 fetch)</span></h2>
        </div>
      </div>

      <div class="table-responsive">
        <table class="rates-table" id="historyTable">
          <thead>
            <tr>
              <th style="text-align: left;">DATE</th>
              <th>24KT</th>
              <th>22KT</th>
              <th>18KT</th>
              <th>14KT</th>
              <th>SILVER</th>
              <th>PLATINUM</th>
            </tr>
          </thead>
          <tbody>
<% rates.priceHistory.forEach(function(row) { %>
            <tr>
              <td><%= row.date %></td>
              <td><%= row.gold24k %></td>
              <td><%= row.gold22k %></td>
              <td><%= row.gold18k %></td>
              <td><%= row.gold14k %></td>
              <td><%= row.silver %></td>
              <td><%= row.platinum %></td>
            </tr>
<% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <!-- Full-Width Satellite Map Section -->
  <section class="contact-map-section" aria-label="Store Location Satellite Map">
    <a href="https://share.google/cu6lY4n09u5U7s5Zb" target="_blank" rel="noopener noreferrer" aria-label="Open Rahul Jewellers in Google Maps">
      <img src="/assets/contact/contact_map.png" alt="Rahul Jewellers Showroom Satellite View - Lucknow Nilmatha" loading="lazy">
    </a>
  </section>

  <!-- Line-Art Palace Footer -->
  <%- include('partials/footer') %>

  <script src="/js/header.js"></script>

  <script>
    // Dynamic Live Cache Poller (refreshes if server has updated cache)
    async function refreshLiveRates() {
      try {
        const res = await fetch('/api/rates');
        if (!res.ok) return;
        const data = await res.json();
        if (data && data.success && data.featured) {
          const goldEl = document.getElementById('featuredGoldVal');
          const silEl = document.getElementById('featuredSilverVal');
          if (goldEl && data.featured.gold24k_10g) goldEl.innerText = data.featured.gold24k_10g.value;
          if (silEl && data.featured.silver_1kg) silEl.innerText = data.featured.silver_1kg.value;
        }
      } catch (e) {}
    }
    // Check every 60 seconds
    setInterval(refreshLiveRates, 60000);
  </script>
</body>
</html>
