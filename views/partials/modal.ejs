<!-- Quick View Modal Component -->
<div class="modal-overlay" id="quickViewModal" role="dialog" aria-modal="true">
  <div class="modal-window">
    <button class="modal-close" id="modalClose" type="button" aria-label="Close details">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    <div class="modal-media">
      <img id="modalProductImg" src="" alt="Product detail">
    </div>

    <div class="modal-body">
      <div class="modal-header">
        <span class="modal-cat-tag" id="modalProductCategory">Fine Jewellery</span>
        <h3 id="modalProductTitle">Artisan Creation</h3>
      </div>

      <div class="modal-specs">
        <div class="spec-item">
          <span class="spec-label">Gold Purity</span>
          <span class="spec-val" id="modalProductPurity">22K Hallmarked</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Diamond Spec</span>
          <span class="spec-val" id="modalProductDiamonds">VVS-EF Natural</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Approx. Weight</span>
          <span class="spec-val" id="modalProductWeight">14.50 gms</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Certification</span>
          <span class="spec-val" id="modalProductCert">BIS 100% Certified</span>
        </div>
      </div>

      <div class="modal-actions">
        <a class="btn-whatsapp" id="modalWhatsappBtn" href="#" target="_blank" rel="noopener noreferrer">
          <span>Inquire on WhatsApp</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        </a>
        <a class="btn-appointment" href="/#contact">
          Book Private Viewing
        </a>
      </div>
    </div>
  </div>
</div>

