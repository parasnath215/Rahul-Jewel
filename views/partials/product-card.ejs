<!-- Product Card Component -->
<div class="product-card" 
     data-id="<%= product.id %>"
     data-title="<%= product.title %>" 
     data-category="<%= categoryHeading %>" 
     data-purity="<%= product.purity %>" 
     data-diamonds="<%= product.diamonds %>" 
     data-weight="<%= product.weight %>"
     data-cert="<%= product.cert %>"
     data-tags="<%= (product.tags || []).join(' ') %>">
  <img class="product-img" src="<%= product.image %>" alt="<%= product.title %>" loading="lazy">
  <button class="view-item-btn" <%= (typeof showFirstBtn !== 'undefined' && showFirstBtn) ? 'style="opacity:1;transform:translateY(0);pointer-events:auto;"' : '' %> type="button" aria-label="View details for <%= product.title %>">
    <span>VIEW ITEM</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</div>

