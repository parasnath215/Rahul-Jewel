<!-- Main Navigation Header -->
<header class="site-header">
  <div class="header-container">
    <a class="brand-logo" href="/" aria-label="Rahul Jewellers Legacy">
        <img src="/assets/logo-footer-transparent.png" alt="Rahul Jewellers Legacy" class="site-brand-logo">
      </a>

    <nav class="nav-menu" aria-label="Primary Navigation">
      <a class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'home') ? 'active' : '' %>" href="/">Home</a>
      <a class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'about') ? 'active' : '' %>" href="/about">About Us</a>
      <div class="nav-item-dropdown">
        <a class="nav-link <%= (typeof activeCategory !== 'undefined') ? 'active' : '' %>" href="/#collections">Collection</a>
        <ul class="dropdown-menu">
          <li><a href="/collections/bangles" class="<%= (typeof activeCategory !== 'undefined' && activeCategory === 'bangles') ? 'active-cat' : '' %>">Bangles</a></li>
          <li><a href="/collections/bracelets" class="<%= (typeof activeCategory !== 'undefined' && activeCategory === 'bracelets') ? 'active-cat' : '' %>">Bracelets</a></li>
          <li><a href="/collections/chains" class="<%= (typeof activeCategory !== 'undefined' && activeCategory === 'chains') ? 'active-cat' : '' %>">Chains</a></li>
          <li><a href="/collections/earrings" class="<%= (typeof activeCategory !== 'undefined' && activeCategory === 'earrings') ? 'active-cat' : '' %>">Earrings</a></li>
          <li><a href="/collections/fancy-chains" class="<%= (typeof activeCategory !== 'undefined' && activeCategory === 'fancy-chains') ? 'active-cat' : '' %>">Fancy Chains</a></li>
          <li><a href="/collections/necklaces" class="<%= (typeof activeCategory !== 'undefined' && activeCategory === 'necklaces') ? 'active-cat' : '' %>">Necklaces</a></li>
          <li><a href="/collections/rings" class="<%= (typeof activeCategory !== 'undefined' && activeCategory === 'rings') ? 'active-cat' : '' %>">Rings</a></li>
          <li><a href="/collections/studs" class="<%= (typeof activeCategory !== 'undefined' && activeCategory === 'studs') ? 'active-cat' : '' %>">Studs</a></li>
        </ul>
      </div>
      <a class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'gold-rates') ? 'active' : '' %>" href="/gold-rates">Gold Rates</a>
      <a class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'contact') ? 'active' : '' %>" href="/contact">Contact</a>
    </nav>

    <button class="mobile-toggle" type="button" aria-label="Toggle Navigation">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>
</header>
